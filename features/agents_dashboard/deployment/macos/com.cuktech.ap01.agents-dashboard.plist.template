</array>
<key>WorkingDirectory</key><string>{{PROJECT}}</string><key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>{{LOG}}</string><key>StandardErrorPath</key><string>{{ERROR_LOG}}</string>
</dict></plist>
